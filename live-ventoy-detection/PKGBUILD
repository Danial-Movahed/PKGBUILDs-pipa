pkgname=live-ventoy-detection
pkgdesc="Package containing configurations needed for booting live iso from ventoy"
pkgver=1
pkgrel=0
url="https://www.ventoy.net/en/compatible.html"
license=('GPL')
arch=('aarch64')
depends=()
source=(
	'vtoydump'
	'ventoy-initcpio-buildhook'
	'ventoy-initcpio-runtimehook'
	'mkinitcpio.conf'
)
