	'82d6a43c32ac884b8ec52c2c8888315a8ee65a42991c8a4c8a97b805b0a52c872398a704f2e37e7bed09a794b24d4f43a8c046585af11221b8d566b925fde7dc'
	'b04da08734cd6f0f7942a755931e173fcd52d040c213f84cabec7cd32db24a0d46982daf987aafecd4ba9942b5efe67bc0b52236390d59d07a63b879788798a6'
	'5f716743e889bf9c3533bf5c93f29a9e7e8c9cdaf61901a697f54b9d33e64a38ac6b0af74b0a238b165fe11696388a23aa09db7b0cebe2eb6ab4ad828299875c'
	'855b546bc267b9b4f27689f64aebd98506037eac758a509e046925c926ebbf8243cccf06c62cd1827d434c9a3615ca9f36e12f92a05d20a724b311daf117e5a9'
)

package() {
	install -Dm755 "vtoydump" "$pkgdir/usr/local/bin/vtoydump"
	install -Dm644 "ventoy-initcpio-buildhook" "$pkgdir/usr/lib/initcpio/install/ventoy"
	install -Dm644 "ventoy-initcpio-runtimehook" "$pkgdir/usr/lib/initcpio/hooks/ventoy"
	install -Dm644 "mkinitcpio.conf" "$pkgdir/etc/mkinitcpio.conf.d/ventoy.conf"
}


